# Polygraph runtime configuration. This file is git-ignored.

# Required. Create a key at https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=

# Optional. Free tier key from https://app.tavily.com (1,000 credits a month).
# Enables changelog and linked-issue research during experiment planning.
TAVILY_API_KEY=

# Optional. Only needed for the Token Factory Sandboxes executor (beta access).
# Copy it from Project settings in Token Factory.
NEBIUS_PROJECT_ID=

# Optional. Raises the GitHub API limit from 60 to 5,000 requests an hour when analysing public PRs.
GITHUB_TOKEN=
